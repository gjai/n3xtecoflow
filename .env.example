# Site
NEXT_PUBLIC_SITE_URL=https://ecoflow-stream.com

# Amazon Associates tag
AMAZON_ASSOCIATE_TAG=ecoflown3xt-21

# Amazon Creators API (Associates Central → Tools → Creators API)
# Required to display live Amazon.fr prices. Needs API access eligibility.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_VERSION=3.2
AMAZON_MARKETPLACE=www.amazon.fr
# AMAZON_PRICES_PATH=/app/data/amazon-prices.json
# AMAZON_CRON_SECRET=  # optional; falls back to NEWS_CRON_SECRET

# Google AdSense client id
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4733644127583822

# Contact form destination (server-side only)
CONTACT_TO_EMAIL=djgjai@gmail.com

# Daily ops digest email (crons / contenu — trafic = Umami)
# STATS_TO_EMAIL=djgjai@gmail.com
# STATS_CRON_SECRET=  # optional; falls back to NEWS_CRON_SECRET

# Umami (service Coolify séparé) — bake au build (NEXT_PUBLIC_*)
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.TON-DOMAINE/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optionnel multi-sites : JSON host → website-id
# NEXT_PUBLIC_UMAMI_WEBSITE_IDS={"ecoflow-stream.com":"...","euromillions-resultats.fr":"..."}

# News / cron (required for GitHub Actions ingest)
NEWS_CRON_SECRET=
# NEWS_DATA_PATH=/app/data/news.json
# GEMINI_API_KEY=   # or OPENAI_API_KEY for AI rewrites (else templates)

# Guides IA (same NEWS_CRON_SECRET; weekly GitHub Action + POST /api/guides/refresh)
# GUIDES_STORE_PATH=/app/data/guides-store.json
# GUIDES_MEDIA_PATH=/app/data/guide-images
# GUIDES_AI_DELAY_MS=500
# CRON_STATUS_PATH=/app/data/cron-status.json

# Persist uploads/cache on Coolify: mount volume to /app/data

# EuroMillions — FDJ affiliation (Kwanko via https://www.fdj.fr/affiliation)
# FDJ_AFFILIATE_URL=https://...tracking...
# EUROMILLIONS_DATA_PATH=/app/data/euromillions.json

# IndexNow (ping Bing/Yandex à chaque nouveau résultat). Clé aussi dans public/{key}.txt
# INDEXNOW_KEY=a4e8c1b27f9d40e6b3c5d8a1f6e2b490
# INDEXNOW_DISABLED=1

# Bing Webmaster URL Submission API (secret — Coolify, pas le git)
# BING_WEBMASTER_API_KEY=
# BING_WEBMASTER_DISABLED=1

# Ahrefs APIv3 public (Domain Rating dans le digest ops). Secret Coolify.
# AHREFS_API_KEY=
# AHREFS_DISABLED=1

# Set to 1 only when AdSense ad slots exist in the UI
# NEXT_PUBLIC_ADSENSE_SLOTS=1
# NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=
